run = "python manage.py migrate && python manage.py collectstatic --noinput && python manage.py runserver 0.0.0.0:3000"
language = "python3"

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "python manage.py migrate && python manage.py collectstatic --noinput && gunicorn platformer_project.wsgi:application --bind 0.0.0.0:3000"]
deploymentTarget = "cloudrun"
